# Copy this file to .env and fill in your real keys.
# Get them from:
#   Deepgram: https://console.deepgram.com     (free trial credit)
#   OpenAI:   https://platform.openai.com/api-keys  (paid, billing required -- runs gpt-6-luna)
#   Cartesia: https://play.cartesia.ai         (free tier) -> also grab a Voice ID
#             from the "Voice Library" tab in your Cartesia console and paste
#             it below (it's a UUID like 794f9389-aac1-45b6-b726-9d9369183238).

DEEPGRAM_API_KEY=
OPENAI_API_KEY=
CARTESIA_API_KEY=
CARTESIA_VOICE_ID=

# OpenAI processing tier for the live conversation: fast (default here, quickest,
# priority pricing), default (standard), auto (project setting) or flex.
OPENAI_SERVICE_TIER=fast

# Twilio: https://console.twilio.com (Account SID / Auth Token on the dashboard)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# The public https URL Twilio's webhooks reach this app on (the ngrok domain,
# no trailing slash).
PUBLIC_BASE_URL=https://president-unruly-fossil.ngrok-free.dev

# MySQL 8
MYSQL_DB=voiceagent
MYSQL_USER=voiceagent_app
MYSQL_PASSWORD=
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306

# Google Drive (call recordings). Client ID/secret come from the OAuth client in
# the Google Cloud project "voice-agent-recordings". The redirect URI must match
# the one registered on that OAuth client byte-for-byte.
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_REDIRECT_URI=https://president-unruly-fossil.ngrok-free.dev/callback
GOOGLE_DRIVE_SHARED_DRIVE_ID=
GOOGLE_DRIVE_FOLDER_ID=
